<?xml version="1.0"?>
<!--
  dual_arm_robot.xacro
  单 Robot + 双 Arm + 单 ControllerManager 架构

  架构：
    world → base_link → left_arm_base → (left arm chain)
                     → right_arm_base → (right arm chain)

  一个 gz_ros2_control plugin 实例，一个 /controller_manager
  left_arm_controller + right_arm_controller 各控制 6 个关节

  使用方法（xacro）：
    <xacro:dual_arm_robot
      name="dual_arm"
      ur_type="ur5e"
      left_origin="0 0.5 0 0 0 0"
      right_origin="0 -0.5 0 0 0 0"
      simulation_controllers="$(find ur_simulation_gz)/config/dual_arm_controllers.yaml"
    />
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="name" default="dual_arm"/>
  <xacro:arg name="ur_type" default="ur5e"/>
  <xacro:arg name="left_origin" default="0 0.5 0 0 0 0"/>
  <xacro:arg name="right_origin" default="0 -0.5 0 0 0 0"/>
  <xacro:arg name="simulation_controllers" default=""/>

  <!--
    joint_limit_params、kinematics_params 等从 ur_description 包读取
    safety_limits=true 让机械臂在安全限制内运动
  -->
  <xacro:arg name="joint_limit_params"
    default="$(find ur_description)/config/$(arg ur_type)/joint_limits.yaml"/>
  <xacro:arg name="kinematics_params"
    default="$(find ur_description)/config/$(arg ur_type)/default_kinematics.yaml"/>
  <xacro:arg name="physical_params"
    default="$(find ur_description)/config/$(arg ur_type)/physical_parameters.yaml"/>
  <xacro:arg name="visual_params"
    default="$(find ur_description)/config/$(arg ur_type)/visual_parameters.yaml"/>

  <!-- ==================== 世界根节点 ==================== -->
  <link name="world"/>
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.6 1.2 0.05"/></geometry>
      <material name="base_plate"><color rgba="0.6 0.6 0.6 0.8"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.6 1.2 0.05"/></geometry>
    </collision>
    <inertial>
      <mass value="10.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
    </inertial>
  </link>
  <joint name="world_to_base" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="world"/>
    <child link="base_link"/>
  </joint>

  <!-- ==================== 左臂安装点 ==================== -->
  <link name="left_arm_base"/>
  <joint name="left_mount" type="fixed">
    <origin xyz="${left_origin}" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="left_arm_base"/>
  </joint>

  <!-- ==================== 右臂安装点 ==================== -->
  <link name="right_arm_base"/>
  <joint name="right_mount" type="fixed">
    <origin xyz="${right_origin}" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="right_arm_base"/>
  </joint>

  <!-- ==================== 左臂（ur_robot macro） ==================== -->
  <!-- left_arm_base 作为 ur_robot 的 parent，origin 已在 left_mount 设置 -->
  <xacro:ur_robot
    name="${name}"
    tf_prefix="left_"
    parent="left_arm_base"
    joint_limits_parameters_file="$(arg joint_limit_params)"
    kinematics_parameters_file="$(arg kinematics_params)"
    physical_parameters_file="$(arg physical_params)"
    visual_parameters_file="$(arg visual_params)"
    safety_limits="true"
    safety_pos_margin="0.15"
    safety_k_position="20"
    force_abs_paths="true">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:ur_robot>

  <!-- ==================== 右臂（ur_robot macro） ==================== -->
  <xacro:ur_robot
    name="${name}"
    tf_prefix="right_"
    parent="right_arm_base"
    joint_limits_parameters_file="$(arg joint_limit_params)"
    kinematics_parameters_file="$(arg kinematics_params)"
    physical_parameters_file="$(arg physical_params)"
    visual_parameters_file="$(arg visual_params)"
    safety_limits="true"
    safety_pos_margin="0.15"
    safety_k_position="20"
    force_abs_paths="true">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:ur_robot>

  <!-- ==================== Gazebo 插件（单一实例） ==================== -->
  <gazebo reference="world"/>
  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(arg simulation_controllers)</parameters>
      <!-- 不设 namespace，单一 CM 在 / 命名空间 -->
    </plugin>
  </gazebo>

  <!-- ==================== ros2_control（单一 CM，声明全部 12 个关节） ==================== -->
  <ros2_control name="DualArmSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <!-- ==================== 左臂 6 个关节 ==================== -->
    <joint name="left_shoulder_pan_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="effort">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>
    <joint name="left_shoulder_lift_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">-1.57</param>
      </state_interface>
      <state_interface name="velocity">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="effort">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>
    <joint name="left_elbow_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="effort">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>
    <joint name="left_wrist_1_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">-1.57</param>
      </state_interface>
      <state_interface name="velocity">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="effort">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>
    <joint name="left_wrist_2_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="effort">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>
    <joint name="left_wrist_3_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="effort">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>

    <!-- ==================== 右臂 6 个关节 ==================== -->
    <joint name="right_shoulder_pan_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="effort">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>
    <joint name="right_shoulder_lift_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">-1.57</param>
      </state_interface>
      <state_interface name="velocity">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="effort">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>
    <joint name="right_elbow_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="effort">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>
    <joint name="right_wrist_1_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">-1.57</param>
      </state_interface>
      <state_interface name="velocity">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="effort">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>
    <joint name="right_wrist_2_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="effort">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>
    <joint name="right_wrist_3_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="effort">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>

  </ros2_control>

</robot>