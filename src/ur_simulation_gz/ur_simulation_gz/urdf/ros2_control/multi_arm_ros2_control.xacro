<?xml version="1.0"?>
<!--
  multi_arm_ros2_control.xacro — ros2_control block for dual-arm + grippers + torso + head.

  16 joints: 6 (left_arm) + 6 (right_arm) + 1 (left_arm gripper) + 1 (right_arm gripper) + 1 (torso) + 1 (head).
  GazeboSimSystem hardware plugin for Gazebo simulation.

  Params:
    controllers_file - controllers yaml path (from simulation_controllers arg)
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="multi_arm_ros2_control" params="controllers_file">

    <!-- Gazebo ros2_control plugin -->
    <gazebo>
      <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>${controllers_file}</parameters>
      </plugin>
    </gazebo>

    <!-- ros2_control (16 joints: 12 arm + 2 gripper + 1 torso + 1 head) -->
    <ros2_control name="MultiArmSystem" type="system">
      <hardware>
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </hardware>

      <!-- torso joint (1 DOF, Z yaw) -->
      <joint name="torso_yaw_joint">
        <command_interface name="position"/>
        <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
        <state_interface name="velocity"><param name="initial_value">0.0</param></state_interface>
        <state_interface name="effort"><param name="initial_value">0.0</param></state_interface>
      </joint>

      <!-- head joint (1 DOF, Y pitch) -->
      <joint name="neck_pitch_joint">
        <command_interface name="position"/>
        <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
        <state_interface name="velocity"><param name="initial_value">0.0</param></state_interface>
        <state_interface name="effort"><param name="initial_value">0.0</param></state_interface>
      </joint>

      <!-- left_arm joints (6 DOF) -->
      <joint name="left_arm_shoulder_pan_joint">
        <command_interface name="position"/>
        <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
        <state_interface name="velocity"><param name="initial_value">0.0</param></state_interface>
        <state_interface name="effort"><param name="initial_value">0.0</param></state_interface>
      </joint>
      <joint name="left_arm_shoulder_lift_joint">
        <command_interface name="position"/>
        <state_interface name="position"><param name="initial_value">-1.57</param></state_interface>
        <state_interface name="velocity"><param name="initial_value">0.0</param></state_interface>
        <state_interface name="effort"><param name="initial_value">0.0</param></state_interface>
      </joint>
      <joint name="left_arm_elbow_joint">
        <command_interface name="position"/>
        <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
        <state_interface name="velocity"><param name="initial_value">0.0</param></state_interface>
        <state_interface name="effort"><param name="initial_value">0.0</param></state_interface>
      </joint>
      <joint name="left_arm_wrist_1_joint">
        <command_interface name="position"/>
        <state_interface name="position"><param name="initial_value">-1.57</param></state_interface>
        <state_interface name="velocity"><param name="initial_value">0.0</param></state_interface>
        <state_interface name="effort"><param name="initial_value">0.0</param></state_interface>
      </joint>
      <joint name="left_arm_wrist_2_joint">
        <command_interface name="position"/>
        <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
        <state_interface name="velocity"><param name="initial_value">0.0</param></state_interface>
        <state_interface name="effort"><param name="initial_value">0.0</param></state_interface>
      </joint>
      <joint name="left_arm_wrist_3_joint">
        <command_interface name="position"/>
        <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
        <state_interface name="velocity"><param name="initial_value">0.0</param></state_interface>
        <state_interface name="effort"><param name="initial_value">0.0</param></state_interface>
      </joint>

      <!-- right_arm joints (6 DOF) -->
      <joint name="right_arm_shoulder_pan_joint">
        <command_interface name="position"/>
        <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
        <state_interface name="velocity"><param name="initial_value">0.0</param></state_interface>
        <state_interface name="effort"><param name="initial_value">0.0</param></state_interface>
      </joint>
      <joint name="right_arm_shoulder_lift_joint">
        <command_interface name="position"/>
        <state_interface name="position"><param name="initial_value">-1.57</param></state_interface>
        <state_interface name="velocity"><param name="initial_value">0.0</param></state_interface>
        <state_interface name="effort"><param name="initial_value">0.0</param></state_interface>
      </joint>
      <joint name="right_arm_elbow_joint">
        <command_interface name="position"/>
        <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
        <state_interface name="velocity"><param name="initial_value">0.0</param></state_interface>
        <state_interface name="effort"><param name="initial_value">0.0</param></state_interface>
      </joint>
      <joint name="right_arm_wrist_1_joint">
        <command_interface name="position"/>
        <state_interface name="position"><param name="initial_value">-1.57</param></state_interface>
        <state_interface name="velocity"><param name="initial_value">0.0</param></state_interface>
        <state_interface name="effort"><param name="initial_value">0.0</param></state_interface>
      </joint>
      <joint name="right_arm_wrist_2_joint">
        <command_interface name="position"/>
        <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
        <state_interface name="velocity"><param name="initial_value">0.0</param></state_interface>
        <state_interface name="effort"><param name="initial_value">0.0</param></state_interface>
      </joint>
      <joint name="right_arm_wrist_3_joint">
        <command_interface name="position"/>
        <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
        <state_interface name="velocity"><param name="initial_value">0.0</param></state_interface>
        <state_interface name="effort"><param name="initial_value">0.0</param></state_interface>
      </joint>

      <!-- left_arm gripper joint (1 DOF, mimic drives the rest) -->
      <joint name="left_arm_robotiq_left_knuckle_joint">
        <command_interface name="position"/>
        <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
        <state_interface name="velocity"><param name="initial_value">0.0</param></state_interface>
        <state_interface name="effort"><param name="initial_value">0.0</param></state_interface>
      </joint>

      <!-- right_arm gripper joint (1 DOF, mimic drives the rest) -->
      <joint name="right_arm_robotiq_left_knuckle_joint">
        <command_interface name="position"/>
        <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
        <state_interface name="velocity"><param name="initial_value">0.0</param></state_interface>
        <state_interface name="effort"><param name="initial_value">0.0</param></state_interface>
      </joint>

    </ros2_control>

  </xacro:macro>

</robot>