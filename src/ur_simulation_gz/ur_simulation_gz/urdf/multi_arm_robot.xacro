<?xml version="1.0"?>
<!--
  multi_arm_robot.xacro — Backward-compatible wrapper for robot.xacro (M7.0.1).

  This file is kept for backward compatibility with existing launch files and
  config files that reference "multi_arm_robot.xacro".
  The actual robot definition is now in robot.xacro (modular assembly).

  Existing references (do not change):
    - src/multi_arm_simulation/launch/*.launch.py
    - src/multi_arm_moveit_config/launch/*.launch.py
    - src/multi_arm_robot_description/config/robot.yaml
    - src/multi_arm_simulation/config/hardware_adapters.yaml
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="multi_arm">

  <xacro:arg name="name" default="multi_arm"/>
  <xacro:arg name="ur_type" default="ur5e"/>
  <xacro:arg name="simulation_controllers" default=""/>

  <xacro:include filename="$(find ur_simulation_gz)/urdf/robot.xacro"/>

</robot>
