<?xml version="1.0"?>
<!--
  imu.xacro — IMU sensor (M7.1 Robot Body Upgrade).

  Gazebo IMU sensor on torso_link for body attitude estimation.
  IMU is on torso, not head — torso attitude is the body attitude.

  Params:
    parent_link  - link to attach IMU to (default "torso_link")
    sensor_name  - sensor name (default "head_imu")
    rate         - update rate Hz (default 100)
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="imu_sensor"
    params="parent_link:='torso_link' sensor_name:='head_imu' rate:=100">
    <gazebo reference="${parent_link}">
      <sensor name="${sensor_name}" type="imu">
        <always_on>1</always_on>
        <update_rate>${rate}</update_rate>
        <topic>${sensor_name}/data</topic>
      </sensor>
    </gazebo>
  </xacro:macro>

</robot>
