<?xml version="1.0"?>
<!--
  pick_place.xml
  BehaviorTree for pick-and-place operation.
  Compatible with BehaviorTree.CPP / Groot for visualization.

  Subtrees used:
  - grasp_strategy: Selector with top/side approach fallback
  - place_sequence: Lift + MoveTo + Place + Retract
-->
<root BTCPP_format="4">
  <BehaviorTree ID="PickPlace">
    <Sequence name="pick_place_sequence">
      <CheckSafety name="pre_safety_check"/>
      <QueryWorld name="query_object_state"/>
      <MoveTo name="move_to_target"/>
      <Grasp approach="top" name="grasp_object"/>
      <Lift height="0.1" name="lift_object"/>
      <Place name="place_object"/>
      <Retract name="retract_arm"/>
    </Sequence>
  </BehaviorTree>

  <!-- Node model for Groot visualization -->
  <TreeNodesModel>
    <Action ID="MoveTo">
      <input_port name="goal">Target position or zone</input_port>
    </Action>
    <Action ID="Grasp">
      <input_port name="approach">Grasp approach: top or side</input_port>
    </Action>
    <Action ID="Place"/>
    <Action ID="Lift">
      <input_port name="height">Lift height in meters</input_port>
    </Action>
    <Action ID="Retract"/>
    <Condition ID="CheckSafety"/>
    <Action ID="QueryWorld"/>
    <Action ID="Recover"/>
  </TreeNodesModel>
</root>