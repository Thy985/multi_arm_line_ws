<?xml version="1.0"?>
<!--
  single_arm.srdf
  SRDF for single UR5e arm (left_arm only) - M4.1 validation
-->
<robot name="ur">

  <group name="left_arm">
    <chain name="left_arm_shoulder_pan_joint" tip_name="left_arm_wrist_3_joint"/>
  </group>

  <end_effector name="left_arm_ee" parent_link="left_arm_wrist_3_joint" group="left_arm"/>

  <group_state name="home" group="left_arm">
    <joint name="left_arm_shoulder_pan_joint" value="0"/>
    <joint name="left_arm_shoulder_lift_joint" value="0"/>
    <joint name="left_arm_elbow_joint" value="0"/>
    <joint name="left_arm_wrist_1_joint" value="0"/>
    <joint name="left_arm_wrist_2_joint" value="0"/>
    <joint name="left_arm_wrist_3_joint" value="0"/>
  </group_state>

  <group_state name="ready" group="left_arm">
    <joint name="left_arm_shoulder_pan_joint" value="0"/>
    <joint name="left_arm_shoulder_lift_joint" value="-1.57"/>
    <joint name="left_arm_elbow_joint" value="1.57"/>
    <joint name="left_arm_wrist_1_joint" value="0"/>
    <joint name="left_arm_wrist_2_joint" value="0"/>
    <joint name="left_arm_wrist_3_joint" value="0"/>
  </group_state>

  <disable_collisions link1="world" link2="base_link" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="left_arm_base_link" reason="Adjacent"/>

</robot>