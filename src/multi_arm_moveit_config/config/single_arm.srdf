<?xml version="1.0"?>
<!--
  single_arm.srdf
  SRDF for single UR5e arm (arm1 only) - M4.1 validation
-->
<robot name="ur">

  <group name="arm1">
    <chain name="arm1_shoulder_pan_joint" tip_name="arm1_wrist_3_joint"/>
  </group>

  <end_effector name="arm1_ee" parent_link="arm1_wrist_3_joint" group="arm1"/>

  <group_state name="home" group="arm1">
    <joint name="arm1_shoulder_pan_joint" value="0"/>
    <joint name="arm1_shoulder_lift_joint" value="0"/>
    <joint name="arm1_elbow_joint" value="0"/>
    <joint name="arm1_wrist_1_joint" value="0"/>
    <joint name="arm1_wrist_2_joint" value="0"/>
    <joint name="arm1_wrist_3_joint" value="0"/>
  </group_state>

  <group_state name="ready" group="arm1">
    <joint name="arm1_shoulder_pan_joint" value="0"/>
    <joint name="arm1_shoulder_lift_joint" value="-1.57"/>
    <joint name="arm1_elbow_joint" value="1.57"/>
    <joint name="arm1_wrist_1_joint" value="0"/>
    <joint name="arm1_wrist_2_joint" value="0"/>
    <joint name="arm1_wrist_3_joint" value="0"/>
  </group_state>

  <disable_collisions link1="world" link2="base_link" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="arm1_base_link" reason="Adjacent"/>

</robot>