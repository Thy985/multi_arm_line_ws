<?xml version="1.0"?>
<!--
  multi_arm.srdf
  SRDF for dual UR5e robot (multi_arm namespace architecture).
  Joint prefixes: left_arm_ / right_arm_ (matching ur_simulation_gz multi_arm_sim.launch.py)
-->
<robot name="multi_arm">

  <!-- left_arm planning group -->
  <group name="left_arm">
    <chain base_link="left_arm_base_link" tip_link="left_arm_wrist_3_link"/>
  </group>

  <!-- right_arm planning group -->
  <group name="right_arm">
    <chain base_link="right_arm_base_link" tip_link="right_arm_wrist_3_link"/>
  </group>

  <!-- Dual arm planning group (both arms together) -->
  <group name="dual_arm">
    <group name="left_arm"/>
    <group name="right_arm"/>
  </group>

  <!-- left_arm gripper group -->
  <group name="left_arm_gripper">
    <joint name="left_arm_robotiq_left_knuckle_joint"/>
  </group>

  <!-- right_arm gripper group -->
  <group name="right_arm_gripper">
    <joint name="right_arm_robotiq_left_knuckle_joint"/>
  </group>

  <!-- torso planning group (M7.1: independent, not combined with arms) -->
  <group name="torso">
    <joint name="torso_yaw_joint"/>
  </group>

  <!-- head planning group (M7.1: perception attention, separate from torso) -->
  <group name="head">
    <joint name="neck_pitch_joint"/>
  </group>

  <!-- left_arm end-effector (gripper) -->
  <end_effector name="left_arm_ee" parent_link="left_arm_robotiq_base_link" group="left_arm_gripper"/>

  <!-- right_arm end-effector (gripper) -->
  <end_effector name="right_arm_ee" parent_link="right_arm_robotiq_base_link" group="right_arm_gripper"/>

  <!-- Named positions -->
  <group_state name="home" group="left_arm">
    <joint name="left_arm_shoulder_pan_joint" value="0"/>
    <joint name="left_arm_shoulder_lift_joint" value="0"/>
    <joint name="left_arm_elbow_joint" value="0"/>
    <joint name="left_arm_wrist_1_joint" value="0"/>
    <joint name="left_arm_wrist_2_joint" value="0"/>
    <joint name="left_arm_wrist_3_joint" value="0"/>
  </group_state>

  <group_state name="home" group="right_arm">
    <joint name="right_arm_shoulder_pan_joint" value="0"/>
    <joint name="right_arm_shoulder_lift_joint" value="0"/>
    <joint name="right_arm_elbow_joint" value="0"/>
    <joint name="right_arm_wrist_1_joint" value="0"/>
    <joint name="right_arm_wrist_2_joint" value="0"/>
    <joint name="right_arm_wrist_3_joint" value="0"/>
  </group_state>

  <group_state name="ready" group="left_arm">
    <joint name="left_arm_shoulder_pan_joint" value="0"/>
    <joint name="left_arm_shoulder_lift_joint" value="-1.57"/>
    <joint name="left_arm_elbow_joint" value="1.57"/>
    <joint name="left_arm_wrist_1_joint" value="0"/>
    <joint name="left_arm_wrist_2_joint" value="0"/>
    <joint name="left_arm_wrist_3_joint" value="0"/>
  </group_state>

  <group_state name="ready" group="right_arm">
    <joint name="right_arm_shoulder_pan_joint" value="0"/>
    <joint name="right_arm_shoulder_lift_joint" value="-1.57"/>
    <joint name="right_arm_elbow_joint" value="1.57"/>
    <joint name="right_arm_wrist_1_joint" value="0"/>
    <joint name="right_arm_wrist_2_joint" value="0"/>
    <joint name="right_arm_wrist_3_joint" value="0"/>
  </group_state>

  <group_state name="home" group="dual_arm">
    <joint name="left_arm_shoulder_pan_joint" value="0"/>
    <joint name="left_arm_shoulder_lift_joint" value="0"/>
    <joint name="left_arm_elbow_joint" value="0"/>
    <joint name="left_arm_wrist_1_joint" value="0"/>
    <joint name="left_arm_wrist_2_joint" value="0"/>
    <joint name="left_arm_wrist_3_joint" value="0"/>
    <joint name="right_arm_shoulder_pan_joint" value="0"/>
    <joint name="right_arm_shoulder_lift_joint" value="0"/>
    <joint name="right_arm_elbow_joint" value="0"/>
    <joint name="right_arm_wrist_1_joint" value="0"/>
    <joint name="right_arm_wrist_2_joint" value="0"/>
    <joint name="right_arm_wrist_3_joint" value="0"/>
  </group_state>

  <group_state name="ready" group="dual_arm">
    <joint name="left_arm_shoulder_pan_joint" value="0"/>
    <joint name="left_arm_shoulder_lift_joint" value="-1.57"/>
    <joint name="left_arm_elbow_joint" value="1.57"/>
    <joint name="left_arm_wrist_1_joint" value="0"/>
    <joint name="left_arm_wrist_2_joint" value="0"/>
    <joint name="left_arm_wrist_3_joint" value="0"/>
    <joint name="right_arm_shoulder_pan_joint" value="0"/>
    <joint name="right_arm_shoulder_lift_joint" value="-1.57"/>
    <joint name="right_arm_elbow_joint" value="1.57"/>
    <joint name="right_arm_wrist_1_joint" value="0"/>
    <joint name="right_arm_wrist_2_joint" value="0"/>
    <joint name="right_arm_wrist_3_joint" value="0"/>
  </group_state>

  <!-- Gripper named positions -->
  <group_state name="open" group="left_arm_gripper">
    <joint name="left_arm_robotiq_left_knuckle_joint" value="0.0"/>
  </group_state>
  <group_state name="closed" group="left_arm_gripper">
    <joint name="left_arm_robotiq_left_knuckle_joint" value="0.8"/>
  </group_state>
  <group_state name="open" group="right_arm_gripper">
    <joint name="right_arm_robotiq_left_knuckle_joint" value="0.0"/>
  </group_state>
  <group_state name="closed" group="right_arm_gripper">
    <joint name="right_arm_robotiq_left_knuckle_joint" value="0.8"/>
  </group_state>

  <!-- Disable collisions for fixed joints -->
  <disable_collisions link1="world" link2="base_link" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="front_panel" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="status_led" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="left_arm_pillar" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="right_arm_pillar" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="wheel_fl" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="wheel_fr" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="wheel_bl" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="wheel_br" reason="Adjacent"/>
  <disable_collisions link1="left_shoulder_mount" link2="left_arm_base_link" reason="Adjacent"/>
  <disable_collisions link1="right_shoulder_mount" link2="right_arm_base_link" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="left_arm_base_link" reason="Never"/>
  <disable_collisions link1="base_link" link2="right_arm_base_link" reason="Never"/>
  <disable_collisions link1="left_arm_base_link" link2="left_arm_base_link_inertia" reason="Adjacent"/>
  <disable_collisions link1="left_arm_base_link_inertia" link2="left_arm_shoulder_link" reason="Adjacent"/>
  <disable_collisions link1="left_arm_shoulder_link" link2="left_arm_upper_arm_link" reason="Adjacent"/>
  <disable_collisions link1="left_arm_upper_arm_link" link2="left_arm_forearm_link" reason="Adjacent"/>
  <disable_collisions link1="left_arm_forearm_link" link2="left_arm_wrist_1_link" reason="Adjacent"/>
  <disable_collisions link1="left_arm_wrist_1_link" link2="left_arm_wrist_2_link" reason="Adjacent"/>
  <disable_collisions link1="left_arm_wrist_2_link" link2="left_arm_wrist_3_link" reason="Adjacent"/>
  <disable_collisions link1="left_arm_wrist_3_link" link2="left_arm_ft_frame" reason="Adjacent"/>
  <disable_collisions link1="left_arm_ft_frame" link2="left_arm_flange" reason="Adjacent"/>
  <disable_collisions link1="left_arm_flange" link2="left_arm_tool0" reason="Adjacent"/>
  <disable_collisions link1="left_arm_base_link" link2="left_arm_base" reason="Adjacent"/>
  <disable_collisions link1="right_arm_base_link" link2="right_arm_base_link_inertia" reason="Adjacent"/>
  <disable_collisions link1="right_arm_base_link_inertia" link2="right_arm_shoulder_link" reason="Adjacent"/>
  <disable_collisions link1="right_arm_shoulder_link" link2="right_arm_upper_arm_link" reason="Adjacent"/>
  <disable_collisions link1="right_arm_upper_arm_link" link2="right_arm_forearm_link" reason="Adjacent"/>
  <disable_collisions link1="right_arm_forearm_link" link2="right_arm_wrist_1_link" reason="Adjacent"/>
  <disable_collisions link1="right_arm_wrist_1_link" link2="right_arm_wrist_2_link" reason="Adjacent"/>
  <disable_collisions link1="right_arm_wrist_2_link" link2="right_arm_wrist_3_link" reason="Adjacent"/>
  <disable_collisions link1="right_arm_wrist_3_link" link2="right_arm_ft_frame" reason="Adjacent"/>
  <disable_collisions link1="right_arm_ft_frame" link2="right_arm_flange" reason="Adjacent"/>
  <disable_collisions link1="right_arm_flange" link2="right_arm_tool0" reason="Adjacent"/>
  <disable_collisions link1="right_arm_base_link" link2="right_arm_base" reason="Adjacent"/>

  <!-- Gripper collision exclusions (left_arm) -->
  <disable_collisions link1="left_arm_tool0" link2="left_arm_robotiq_base_link" reason="Adjacent"/>
  <disable_collisions link1="left_arm_robotiq_base_link" link2="left_arm_robotiq_left_knuckle_link" reason="Adjacent"/>
  <disable_collisions link1="left_arm_robotiq_base_link" link2="left_arm_robotiq_right_knuckle_link" reason="Adjacent"/>
  <disable_collisions link1="left_arm_robotiq_left_knuckle_link" link2="left_arm_robotiq_left_finger_link" reason="Adjacent"/>
  <disable_collisions link1="left_arm_robotiq_right_knuckle_link" link2="left_arm_robotiq_right_finger_link" reason="Adjacent"/>
  <disable_collisions link1="left_arm_robotiq_left_finger_link" link2="left_arm_robotiq_left_finger_tip_link" reason="Adjacent"/>
  <disable_collisions link1="left_arm_robotiq_right_finger_link" link2="left_arm_robotiq_right_finger_tip_link" reason="Adjacent"/>
  <disable_collisions link1="left_arm_wrist_3_link" link2="left_arm_robotiq_base_link" reason="Never"/>
  <disable_collisions link1="left_arm_flange" link2="left_arm_robotiq_base_link" reason="Never"/>
  <disable_collisions link1="left_arm_ft_frame" link2="left_arm_robotiq_base_link" reason="Never"/>

  <!-- Gripper collision exclusions (right_arm) -->
  <disable_collisions link1="right_arm_tool0" link2="right_arm_robotiq_base_link" reason="Adjacent"/>
  <disable_collisions link1="right_arm_robotiq_base_link" link2="right_arm_robotiq_left_knuckle_link" reason="Adjacent"/>
  <disable_collisions link1="right_arm_robotiq_base_link" link2="right_arm_robotiq_right_knuckle_link" reason="Adjacent"/>
  <disable_collisions link1="right_arm_robotiq_left_knuckle_link" link2="right_arm_robotiq_left_finger_link" reason="Adjacent"/>
  <disable_collisions link1="right_arm_robotiq_right_knuckle_link" link2="right_arm_robotiq_right_finger_link" reason="Adjacent"/>
  <disable_collisions link1="right_arm_robotiq_left_finger_link" link2="right_arm_robotiq_left_finger_tip_link" reason="Adjacent"/>
  <disable_collisions link1="right_arm_robotiq_right_finger_link" link2="right_arm_robotiq_right_finger_tip_link" reason="Adjacent"/>
  <disable_collisions link1="right_arm_wrist_3_link" link2="right_arm_robotiq_base_link" reason="Never"/>
  <disable_collisions link1="right_arm_flange" link2="right_arm_robotiq_base_link" reason="Never"/>
  <disable_collisions link1="right_arm_ft_frame" link2="right_arm_robotiq_base_link" reason="Never"/>

  <!-- Torso + Head collision exclusions (M7.1) -->
  <disable_collisions link1="base_link" link2="torso_link" reason="Adjacent"/>
  <disable_collisions link1="torso_link" link2="head_link" reason="Adjacent"/>
  <disable_collisions link1="torso_link" link2="left_shoulder_mount" reason="Adjacent"/>
  <disable_collisions link1="torso_link" link2="right_shoulder_mount" reason="Adjacent"/>
  <disable_collisions link1="head_link" link2="head_rgb_link" reason="Adjacent"/>
  <disable_collisions link1="head_link" link2="head_depth_link" reason="Adjacent"/>
  <disable_collisions link1="head_link" link2="head_imu_link" reason="Adjacent"/>

</robot>