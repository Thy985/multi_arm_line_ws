Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Displays:
      - Class: rviz_default_plugins/Grid
        Name: Grid
        Reference Frame: world
        Plane Cell Count: 10
        Color: 100; 100; 100
      - Class: rviz_default_plugins/RobotModel
        Name: RobotModel arm1
        Description Topic:
          Depth: 5
          Durability Policy: Volatile
          History Policy: Keep Last
          Reliability Policy: Reliable
          Value: /arm1/robot_description
        Visual Enabled: true
      - Class: rviz_default_plugins/RobotModel
        Name: RobotModel arm2
        Description Topic:
          Depth: 5
          Durability Policy: Volatile
          History Policy: Keep Last
          Reliability Policy: Reliable
          Value: /arm2/robot_description
        Visual Enabled: true
      - Class: rviz_default_plugins/TF
        Name: TF
        Show Arrows: false
        Show Axes: true
        Show Names: true
        Update Interval: 0
      - Class: moveit_rviz_plugin/MotionPlanningDisplay
        Name: MotionPlanning
        Planning Group: arm1
        Trajectory Topic: /move_group/display_planned_path
        Robot Description: robot_description
        Scene Robot:
          Attached Body Color: 150; 50; 150
        Planning Request:
          Planning Group: arm1
          Planning Time: 0.5
    Splitter Ratio: 0.5
  - Class: rviz_common/Views
    Name: Views
    Expanded:
      - Current View
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays: []
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: world
    Frame Rate: 30
  Name: ""
Window Geometry:
  Width: 1400
  Height: 900
  X: 100
  Y: 100
